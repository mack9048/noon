APP_NAME="Noon Learn API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Dubai
APP_VERSION=0.2.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8, utf8mb4 (needed for Arabic, Malayalam and emoji)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=noon_learn
DB_USERNAME=noon_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
# true only on hosting without Supervisor (cron then runs the queue)
QUEUE_VIA_SCHEDULER=false

# Vercel web app + local Expo web. Comma separated, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Optional: allow all Vercel preview deployments
CORS_ALLOWED_PATTERN='#^https://noon-learn-[a-z0-9-]+\.vercel\.app$#'

# Sanctum tokens expire after 30 days (minutes)
SANCTUM_EXPIRATION=43200

# SMS codes. log = written to storage/logs/laravel.log. msg91 (India) or twilio (Gulf/international) in production.
OTP_DRIVER=log
OTP_TTL_MINUTES=5
OTP_RESEND_AFTER=30
# Local demos only (ignored when APP_ENV=production): every code is this.
OTP_FIXED_CODE=123456
# Added to local numbers typed without a country code (91 India, 971 UAE)
DEFAULT_COUNTRY_CODE=971
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
