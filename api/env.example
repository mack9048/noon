# --- Merge these into api/server/.env ---
APP_NAME="Noon Learn API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
APP_TIMEZONE=Asia/Dubai

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=noon_learn
DB_USERNAME=noon_user
DB_PASSWORD=change-me

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# Vercel web app + local Expo web. Comma separated, no trailing slash.
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://noon-learn.vercel.app,http://localhost:8081
# Optional: allow all Vercel preview deployments
CORS_ALLOWED_PATTERN="#^https://noon-learn-[a-z0-9-]+\.vercel\.app$#"

# Sanctum tokens expire after 30 days (minutes)
SANCTUM_EXPIRATION=43200
