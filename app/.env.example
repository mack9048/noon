# Laravel API base URL (Hostinger cloud server). Must end with /api
EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
# 1 = use built-in demo data (no backend needed), 0 = call the real API
EXPO_PUBLIC_USE_MOCK=1
# DEMO ONLY: one-tap demo login buttons on the login page. Set to 0 before launch.
EXPO_PUBLIC_DEMO_LOGINS=1
