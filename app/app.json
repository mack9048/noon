{
  "expo": {
    "name": "Noon Learn",
    "slug": "noon-learn",
    "scheme": "noonlearn",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noonlearn.app"
    },
    "android": {
      "package": "com.noonlearn.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B5166"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
